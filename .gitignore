2107050_graphics.pdf
*_graphics.pdf
*reference*.pdf
*sample*.pdf
!main.pdf

# ==========================================
# Python Cache & Artifacts
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
build_unified_master_doc.py
*.docx
WORKFLOW_AND_ALGORITHMS.pdf

# ==========================================
# Temporary, Dump & Scratch Files
# ==========================================
no-manifest.specs
*.specs
specs_temp
test_glut.cpp
test_*
page1_*
*.tmp
*.temp
*.bak
*.swp
*~

# ==========================================
# Runtime Generated Captures & Frame Dumps
# ==========================================
raytrace.bmp
*.ppm
shots/*
!shots/.keep

# ==========================================
# IDE & Editor Settings
# ==========================================
# Visual Studio
.vs/
*.suo
*.user
*.userosv
*.sln.docstates
*.vcxproj.user

# VS Code (preserve shared tasks and include paths, ignore local caches)
.vscode/*
!.vscode/tasks.json
!.vscode/c_cpp_properties.json
!.vscode/launch.json
.vscode/.browse.VC.db*

# JetBrains / CLion
.idea/

# Sublime Text
*.sublime-workspace
*.sublime-project

# ==========================================
