# ==========================================
# C / C++ Compiled Binaries & Executables
# ==========================================
*.exe
*.out
*.app
*.bin
*.hex
*.com

# Heavy third-party binary accidentally placed in project root
tectonic.exe

# ==========================================
# Object Files & Intermediate Build Files
# ==========================================
*.o
*.obj
*.so
*.dylib

# Default ignore for binary libraries, with exceptions below
*.dll
*.a
*.lib

# Preserve project-bundled dependencies needed to build & run
!/glfw3.dll
!/lib/
!/lib/**

# ==========================================
# Build Systems & Debug Output
# ==========================================
# MSVC / MinGW debug files
*.pdb
*.ilk
*.idb
*.exp
*.map
*.log
*.tlog

# Output directories
build/
bin/
out/
dist/
x64/
x86/
Debug/
Release/

# CMake cache and artifacts
CMakeFiles/
CMakeScripts/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
cmake-build-*/

